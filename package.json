{
  "name": "private-notes",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.0.0 <25",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "dev": "node tooling/build.mjs --watch",
    "dev:ui": "vite --host 127.0.0.1",
    "build": "node tooling/build.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc -p tsconfig.ui.json && tsc -p tsconfig.plugin.json && tsc -p tsconfig.tools.json && tsc -p experiments/private-notes/tsconfig.json && tsc -p experiments/private-notes/tsconfig.ui.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test && pnpm build && pnpm probe:notes:build",
    "plugin:id": "node tooling/plugin-id.mjs",
    "probe:comment:build": "tsc -p experiments/native-comment-navigation/tsconfig.json && node tooling/build-comment-probe.mjs",
    "test:probe": "vitest run tests/experiments/native-comment-navigation.test.ts",
    "probe:notes:build": "tsc -p experiments/private-notes/tsconfig.json && tsc -p experiments/private-notes/tsconfig.ui.json && node tooling/build-private-notes-probe.mjs",
    "test:probe:notes": "vitest run tests/experiments/private-notes-probe.test.ts"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@figma/plugin-typings": "1.142.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.9",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "esbuild": "0.28.2",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "jsdom": "31.0.0",
    "prettier": "3.10.0",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.8",
    "vite-plugin-singlefile": "2.3.4",
    "vitest": "5.1.0",
    "@typescript/native": "npm:typescript@7.0.2"
  }
}
